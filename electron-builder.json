{
  "appId": "com.worcco.orbit",
  "productName": "Orbit",
  "copyright": "Copyright © 2026 Worcco. All rights reserved.",
  "compression": "normal",
  "directories": {
    "output": "dist-installer",
    "buildResources": "assets"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "assets/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "assets/orbit.ico",
    "executableName": "Orbit",
    "artifactName": "OrbitSetup.exe",
    "legalTrademarks": "Worcco",
    "fileAssociations": [
      {
        "ext": "html",
        "name": "HTML Document",
        "description": "HTML Document",
        "role": "Viewer"
      },
      {
        "ext": "htm",
        "name": "HTML Document",
        "description": "HTML Document",
        "role": "Viewer"
      }
    ],
    "protocols": [
      {
        "name": "HTTP URL",
        "schemes": [
          "http",
          "https"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": false,
    "installerIcon": "assets/orbit.ico",
    "uninstallerIcon": "assets/orbit.ico",
    "installerHeaderIcon": "assets/orbit.ico",
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "Orbit",
    "uninstallDisplayName": "Orbit Browser by Worcco",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "include": "build/installer.nsh"
  }
}
