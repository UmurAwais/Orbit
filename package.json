{
  "name": "orbit",
  "version": "1.0.0",
  "description": "A custom desktop browser",
  "main": "electron/main.js",
  "type": "module",
  "productName": "Orbit",
  "appId": "com.orbit.browser",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:3000 && nodemon --watch electron --ext js,cjs --exec cross-env VITE_DEV_SERVER_URL=http://localhost:3000 electron .\"",
    "build": "vite build",
    "make": "npm run build && electron-forge make",
    "package": "npm run build && electron-forge package",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/vite": "^4.1.18",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.564.0",
    "markdown-to-jsx": "^9.7.6",
    "node-fetch": "^3.3.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.4.1",
    "electron-builder": "^26.8.1",
    "jsdom": "^28.1.0",
    "nodemon": "^3.1.11",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.4"
  }
}
